{
  "name": "@knowledgeislands/git-almanac",
  "description": "Inspect one local Git repository's calendars, authors, contributors, and reports offline.",
  "version": "0.1.0",
  "author": "kris@kris.me.uk",
  "bin": {
    "git-almanac": "dist/cli/cli.js"
  },
  "bugs": {
    "url": "https://github.com/knowledgeislands/tools-git-almanac/issues"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^5.0.0",
    "husky": "^9.1.7",
    "knip": "^6.34.0",
    "lint-staged": "^17.4.1",
    "rumdl": "^0.2.64",
    "syncpack": "^15.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "man",
    "README.md",
    "LICENSE"
  ],
  "homepage": "https://github.com/knowledgeislands/tools-git-almanac#readme",
  "keywords": [
    "calendar",
    "cli",
    "git",
    "visualization"
  ],
  "license": "MIT",
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,jsonc}": [
      "bunx @biomejs/biome check --write --no-errors-on-unmatched"
    ],
    "*.md": [
      "bunx rumdl check --fix"
    ]
  },
  "packageManager": "bun@1.4.1",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knowledgeislands/tools-git-almanac.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli/cli.js",
    "clean": "rm -rf dist node_modules",
    "ki:deps:update": "bun update --latest",
    "ki:tools:lint-man": "mandoc -T lint man/git-almanac.1",
    "prepare": "husky",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "type": "module"
}
